{
  "$defs": {
    "AppState": {
      "additionalProperties": false,
      "description": "The whole state tree sent in snapshots and modified by patches.",
      "properties": {
        "cameras": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/CameraState"
              },
              "propertyNames": {
                "$ref": "#/$defs/CameraRoleName"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Connected camera roles."
        },
        "equipment": {
          "anyOf": [
            {
              "$ref": "#/$defs/EquipmentState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "indi": {
          "anyOf": [
            {
              "$ref": "#/$defs/IndiState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "jobs": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JobInfo"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Running jobs and the most recent finished ones."
        }
      },
      "title": "AppState",
      "type": "object"
    },
    "BlobInfo": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string"
        },
        "size": {
          "type": "integer"
        }
      },
      "required": [
        "format",
        "size"
      ],
      "title": "BlobInfo",
      "type": "object"
    },
    "CameraRoleName": {
      "enum": [
        "main_camera",
        "guide_camera"
      ],
      "type": "string"
    },
    "CameraSettingsRequest": {
      "additionalProperties": false,
      "description": "Only the fields present are changed.",
      "properties": {
        "binning": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "frame_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameTypeName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "gain": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "offset": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "region": {
          "anyOf": [
            {
              "$ref": "#/$defs/Region"
            },
            {
              "const": "full",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A readout region, or \"full\" for the whole sensor."
        }
      },
      "title": "CameraSettingsRequest",
      "type": "object"
    },
    "CameraState": {
      "additionalProperties": false,
      "properties": {
        "bayer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Color filter pattern (e.g. RGGB); None for mono."
        },
        "binning": {
          "items": {
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "cooler": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Cooler on; None if the camera has none."
        },
        "cooler_power": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "As reported by the driver; units vary."
        },
        "device": {
          "type": "string"
        },
        "exposing": {
          "type": "boolean"
        },
        "frame_type": {
          "$ref": "#/$defs/FrameTypeName"
        },
        "gain": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "gain_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValueRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_frame": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameInfo"
            },
            {
              "type": "null"
            }
          ]
        },
        "max_binning": {
          "type": "integer"
        },
        "offset": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "offset_range": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValueRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "preview": {
          "anyOf": [
            {
              "$ref": "#/$defs/Preview"
            },
            {
              "type": "null"
            }
          ],
          "description": "Latest preview, from any exposure or loop."
        },
        "ramp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Cooling rate limit, \u00b0C/min; 0 = unlimited."
        },
        "region": {
          "$ref": "#/$defs/Region"
        },
        "remaining": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Seconds left in the current exposure."
        },
        "sensor": {
          "$ref": "#/$defs/SensorInfo"
        },
        "target": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Cooling target set through NOCS, \u00b0C."
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Sensor temperature, \u00b0C; None if unknown."
        }
      },
      "required": [
        "device",
        "exposing",
        "remaining",
        "temperature",
        "cooler",
        "cooler_power",
        "target",
        "ramp",
        "gain",
        "gain_range",
        "offset",
        "offset_range",
        "binning",
        "max_binning",
        "region",
        "frame_type",
        "sensor",
        "bayer",
        "last_frame",
        "preview"
      ],
      "title": "CameraState",
      "type": "object"
    },
    "ConnectRequest": {
      "properties": {
        "profile": {
          "type": "string"
        }
      },
      "required": [
        "profile"
      ],
      "title": "ConnectRequest",
      "type": "object"
    },
    "ConnectionName": {
      "enum": [
        "disconnected",
        "connecting",
        "connected",
        "disconnecting"
      ],
      "type": "string"
    },
    "CoolingRequest": {
      "additionalProperties": false,
      "properties": {
        "on": {
          "type": "boolean"
        },
        "ramp": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "\u00b0C/min; 0 = unlimited."
        },
        "target": {
          "anyOf": [
            {
              "maximum": 40,
              "minimum": -60,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "\u00b0C; needed to cool."
        }
      },
      "required": [
        "on"
      ],
      "title": "CoolingRequest",
      "type": "object"
    },
    "DeviceConfig": {
      "additionalProperties": false,
      "properties": {
        "device": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "INDI device name. When omitted, the device of this driver that offers the role's interface is used; required when there are several."
        },
        "driver": {
          "$ref": "#/$defs/DriverName",
          "description": "INDI driver executable, e.g. indi_asi_ccd."
        },
        "port": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Serial port for DEVICE_PORT, preferably a /dev/serial/by-id/ path."
        }
      },
      "required": [
        "driver"
      ],
      "title": "DeviceConfig",
      "type": "object"
    },
    "DeviceStatusName": {
      "enum": [
        "waiting",
        "connecting",
        "ready",
        "error",
        "disconnected"
      ],
      "type": "string"
    },
    "Driver": {
      "properties": {
        "driver": {
          "description": "Executable, e.g. indi_asi_ccd.",
          "type": "string"
        },
        "group": {
          "type": "string"
        },
        "label": {
          "description": "Device model the entry is for (one driver, many models).",
          "type": "string"
        },
        "manufacturer": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "driver",
        "name",
        "label",
        "manufacturer",
        "group"
      ],
      "title": "Driver",
      "type": "object"
    },
    "DriverName": {
      "pattern": "^[A-Za-z0-9_.+-]{1,128}$",
      "type": "string"
    },
    "EquipmentState": {
      "additionalProperties": false,
      "properties": {
        "active": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Id of the selected profile."
        },
        "connection": {
          "$ref": "#/$defs/ConnectionName"
        },
        "devices": {
          "additionalProperties": {
            "$ref": "#/$defs/RoleState"
          },
          "description": "Roles of the active profile.",
          "propertyNames": {
            "$ref": "#/$defs/Role"
          },
          "type": "object"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why the profile cannot be connected right now."
        },
        "profiles": {
          "additionalProperties": {
            "$ref": "#/$defs/ProfileSummary"
          },
          "type": "object"
        }
      },
      "required": [
        "profiles",
        "active",
        "connection",
        "error",
        "devices"
      ],
      "title": "EquipmentState",
      "type": "object"
    },
    "ExposeRequest": {
      "additionalProperties": false,
      "properties": {
        "exposure": {
          "description": "Seconds.",
          "maximum": 7200,
          "minimum": 0,
          "type": "number"
        },
        "frame_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameTypeName"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defaults to the camera's current frame type."
        },
        "save": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "exposure"
      ],
      "title": "ExposeRequest",
      "type": "object"
    },
    "FrameInfo": {
      "additionalProperties": false,
      "properties": {
        "exposure": {
          "type": "number"
        },
        "format": {
          "description": "File extension sent by the driver, e.g. .fits.",
          "type": "string"
        },
        "frame_type": {
          "$ref": "#/$defs/FrameTypeName"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where it was saved; None if it was not."
        },
        "size": {
          "description": "Bytes.",
          "type": "integer"
        },
        "time": {
          "description": "UTC, ISO 8601, when the image arrived.",
          "type": "string"
        }
      },
      "required": [
        "exposure",
        "frame_type",
        "format",
        "size",
        "time",
        "path"
      ],
      "title": "FrameInfo",
      "type": "object"
    },
    "FrameTypeName": {
      "enum": [
        "light",
        "dark",
        "bias",
        "flat"
      ],
      "type": "string"
    },
    "Health": {
      "properties": {
        "indi_connected": {
          "type": "boolean"
        },
        "status": {
          "const": "ok",
          "default": "ok",
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "version",
        "indi_connected"
      ],
      "title": "Health",
      "type": "object"
    },
    "Hello": {
      "description": "First client message: the state epoch and version the client already holds, if any.",
      "properties": {
        "epoch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "since": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "hello",
          "default": "hello",
          "type": "string"
        }
      },
      "title": "Hello",
      "type": "object"
    },
    "IndiDevice": {
      "additionalProperties": false,
      "properties": {
        "interfaces": {
          "description": "Present once DRIVER_INFO is defined.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "properties": {
          "additionalProperties": {
            "$ref": "#/$defs/IndiProperty"
          },
          "type": "object"
        }
      },
      "title": "IndiDevice",
      "type": "object"
    },
    "IndiMessage": {
      "additionalProperties": false,
      "properties": {
        "device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "device",
        "timestamp",
        "text"
      ],
      "title": "IndiMessage",
      "type": "object"
    },
    "IndiNumberElement": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "max": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "step": {
          "type": "number"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "label",
        "value",
        "format",
        "min",
        "max",
        "step"
      ],
      "title": "IndiNumberElement",
      "type": "object"
    },
    "IndiProperty": {
      "additionalProperties": false,
      "properties": {
        "elements": {
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/IndiNumberElement"
              },
              {
                "$ref": "#/$defs/IndiValueElement"
              }
            ]
          },
          "type": "object"
        },
        "group": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "perm": {
          "enum": [
            "ro",
            "wo",
            "rw"
          ],
          "type": "string"
        },
        "rule": {
          "anyOf": [
            {
              "enum": [
                "OneOfMany",
                "AtMostOne",
                "AnyOfMany"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/PropertyStateName"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "enum": [
            "text",
            "number",
            "switch",
            "light",
            "blob"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "label",
        "group",
        "state",
        "perm",
        "rule",
        "timestamp",
        "message",
        "elements"
      ],
      "title": "IndiProperty",
      "type": "object"
    },
    "IndiServer": {
      "additionalProperties": false,
      "properties": {
        "connected": {
          "type": "boolean"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer"
        }
      },
      "required": [
        "host",
        "port",
        "connected",
        "error"
      ],
      "title": "IndiServer",
      "type": "object"
    },
    "IndiState": {
      "additionalProperties": false,
      "properties": {
        "devices": {
          "additionalProperties": {
            "$ref": "#/$defs/IndiDevice"
          },
          "type": "object"
        },
        "messages": {
          "items": {
            "$ref": "#/$defs/IndiMessage"
          },
          "type": "array"
        },
        "server": {
          "anyOf": [
            {
              "$ref": "#/$defs/IndiServer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "IndiState",
      "type": "object"
    },
    "IndiValueElement": {
      "additionalProperties": false,
      "description": "Text (string), switch (bool), light (state name) or BLOB (metadata only).",
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/BlobInfo"
            }
          ]
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "IndiValueElement",
      "type": "object"
    },
    "JobInfo": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "finished": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string"
        },
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "progress": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "0 to 1; None while unknown."
        },
        "resources": {
          "description": "Equipment roles the job locks.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "result": {
          "description": "Kind-specific; for exposures, a FrameInfo."
        },
        "started": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/JobStateName"
        }
      },
      "required": [
        "kind",
        "resources",
        "state",
        "progress",
        "message",
        "error",
        "result",
        "started",
        "finished"
      ],
      "title": "JobInfo",
      "type": "object"
    },
    "JobStarted": {
      "properties": {
        "job": {
          "type": "string"
        }
      },
      "required": [
        "job"
      ],
      "title": "JobStarted",
      "type": "object"
    },
    "JobStateName": {
      "enum": [
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "LoopRequest": {
      "additionalProperties": false,
      "description": "Expose repeatedly for previews (nothing is saved) until the job is cancelled.",
      "properties": {
        "exposure": {
          "description": "Seconds.",
          "maximum": 600,
          "minimum": 0,
          "type": "number"
        },
        "frame_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameTypeName"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "exposure"
      ],
      "title": "LoopRequest",
      "type": "object"
    },
    "Optics": {
      "additionalProperties": false,
      "properties": {
        "aperture": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Aperture in mm."
        },
        "focal_length": {
          "description": "Native focal length in mm.",
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "reducer": {
          "default": 1.0,
          "description": "Reducer or barlow factor.",
          "exclusiveMinimum": 0,
          "type": "number"
        }
      },
      "required": [
        "focal_length"
      ],
      "title": "Optics",
      "type": "object"
    },
    "PatchMessage": {
      "properties": {
        "ops": {
          "items": {
            "$ref": "#/$defs/PatchOp"
          },
          "type": "array"
        },
        "type": {
          "const": "patch",
          "default": "patch",
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      },
      "required": [
        "type",
        "version",
        "ops"
      ],
      "title": "PatchMessage",
      "type": "object"
    },
    "PatchOp": {
      "properties": {
        "op": {
          "enum": [
            "set",
            "delete"
          ],
          "type": "string"
        },
        "path": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "value": {
          "default": null
        }
      },
      "required": [
        "op",
        "path",
        "value"
      ],
      "title": "PatchOp",
      "type": "object"
    },
    "Preview": {
      "additionalProperties": false,
      "properties": {
        "color": {
          "type": "boolean"
        },
        "exposure": {
          "type": "number"
        },
        "frame_type": {
          "$ref": "#/$defs/FrameTypeName"
        },
        "height": {
          "type": "integer"
        },
        "hfr": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Median half-flux radius, unbinned pixels."
        },
        "histogram": {
          "description": "256 bins over the 16-bit range, linear data.",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "seconds": {
          "description": "Time the worker took.",
          "type": "number"
        },
        "stars": {
          "type": "integer"
        },
        "time": {
          "description": "UTC, ISO 8601, when the frame arrived.",
          "type": "string"
        },
        "url": {
          "description": "JPEG, at most 1920 px wide; immutable.",
          "type": "string"
        },
        "width": {
          "type": "integer"
        }
      },
      "required": [
        "url",
        "width",
        "height",
        "color",
        "stars",
        "hfr",
        "histogram",
        "exposure",
        "frame_type",
        "time",
        "seconds"
      ],
      "title": "Preview",
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "devices": {
          "additionalProperties": {
            "$ref": "#/$defs/DeviceConfig"
          },
          "propertyNames": {
            "$ref": "#/$defs/Role"
          },
          "type": "object"
        },
        "guiding": {
          "anyOf": [
            {
              "$ref": "#/$defs/Optics"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optics of the guiding train (guide scope or OAG)."
        },
        "imaging": {
          "anyOf": [
            {
              "$ref": "#/$defs/Optics"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optics of the imaging train."
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        "site": {
          "anyOf": [
            {
              "$ref": "#/$defs/Site"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name"
      ],
      "title": "Profile",
      "type": "object"
    },
    "ProfileSummary": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "ProfileSummary",
      "type": "object"
    },
    "PropertyStateName": {
      "enum": [
        "Idle",
        "Ok",
        "Busy",
        "Alert"
      ],
      "type": "string"
    },
    "Region": {
      "additionalProperties": false,
      "description": "Part of the sensor, in unbinned pixels.",
      "properties": {
        "height": {
          "minimum": 1,
          "type": "integer"
        },
        "width": {
          "minimum": 1,
          "type": "integer"
        },
        "x": {
          "minimum": 0,
          "type": "integer"
        },
        "y": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "title": "Region",
      "type": "object"
    },
    "Role": {
      "enum": [
        "main_camera",
        "guide_camera",
        "mount",
        "focuser",
        "filter_wheel",
        "power_box"
      ],
      "title": "Role",
      "type": "string"
    },
    "RoleState": {
      "additionalProperties": false,
      "properties": {
        "device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "INDI device name, once known."
        },
        "driver": {
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/DeviceStatusName"
        }
      },
      "required": [
        "driver",
        "device",
        "status",
        "error"
      ],
      "title": "RoleState",
      "type": "object"
    },
    "SensorInfo": {
      "additionalProperties": false,
      "properties": {
        "bits": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "pixel_size": {
          "description": "Micrometres.",
          "type": "number"
        },
        "width": {
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "pixel_size",
        "bits"
      ],
      "title": "SensorInfo",
      "type": "object"
    },
    "SerialPortInfo": {
      "properties": {
        "device": {
          "description": "Device node it points to now.",
          "type": "string"
        },
        "path": {
          "description": "Stable /dev/serial/by-id/ name.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "device"
      ],
      "title": "SerialPortInfo",
      "type": "object"
    },
    "SetPropertyRequest": {
      "properties": {
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "minProperties": 1,
          "type": "object"
        }
      },
      "required": [
        "values"
      ],
      "title": "SetPropertyRequest",
      "type": "object"
    },
    "Site": {
      "additionalProperties": false,
      "properties": {
        "elevation": {
          "default": 0.0,
          "description": "Metres above sea level.",
          "type": "number"
        },
        "latitude": {
          "description": "Degrees, north positive.",
          "maximum": 90,
          "minimum": -90,
          "type": "number"
        },
        "longitude": {
          "description": "Degrees, east positive.",
          "maximum": 180,
          "minimum": -180,
          "type": "number"
        },
        "name": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "title": "Site",
      "type": "object"
    },
    "SnapshotMessage": {
      "properties": {
        "epoch": {
          "type": "string"
        },
        "state": {
          "additionalProperties": true,
          "type": "object"
        },
        "type": {
          "const": "snapshot",
          "default": "snapshot",
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      },
      "required": [
        "type",
        "epoch",
        "version",
        "state"
      ],
      "title": "SnapshotMessage",
      "type": "object"
    },
    "StateSnapshot": {
      "properties": {
        "state": {
          "additionalProperties": true,
          "type": "object"
        },
        "version": {
          "type": "integer"
        }
      },
      "required": [
        "version",
        "state"
      ],
      "title": "StateSnapshot",
      "type": "object"
    },
    "ValueRange": {
      "additionalProperties": false,
      "properties": {
        "max": {
          "type": "number"
        },
        "min": {
          "type": "number"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "title": "ValueRange",
      "type": "object"
    }
  },
  "title": "NOCS API"
}
