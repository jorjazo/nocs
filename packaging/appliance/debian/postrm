#!/bin/sh
# As dh_installsystemd generates it. systemd-networkd stays disabled: the network
# NetworkManager runs is the one the box has now.
set -e

if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi
if [ -x /usr/bin/deb-systemd-helper ]; then
    if [ "$1" = "remove" ]; then
        deb-systemd-helper mask nocs-firewall.service >/dev/null || true
    fi
    if [ "$1" = "purge" ]; then
        deb-systemd-helper purge nocs-firewall.service >/dev/null || true
        deb-systemd-helper unmask nocs-firewall.service >/dev/null || true
    fi
fi
