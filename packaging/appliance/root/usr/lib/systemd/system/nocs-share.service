# The SMB share of the frames for desktop computers (ADR 0037): smbd on the
# configuration nocs-system writes, read-only, for guests and the published login
# nocs / nocs. nocs-system enables and starts it when the owner switches the share
# on in the app; Samba's own smbd.service stays masked.
#
# No ProtectSystem, PrivateTmp or ProtectHome: they would give smbd a mount
# namespace of its own, where a USB drive ejected by nocs-system could stay mounted
# while smbd holds it.
[Unit]
Description=NOCS SMB share of the frames
Documentation=https://github.com/jorjazo/nocs/blob/main/docs/adr/0037-smb-share.md
Wants=network-online.target
After=network.target network-online.target avahi-daemon.service
ConditionPathExists=/etc/nocs/share/smb.conf

[Service]
Type=notify
NotifyAccess=all
PIDFile=/run/nocs-share/smbd.pid
ExecStart=/usr/sbin/smbd --foreground --no-process-group --configfile=/etc/nocs/share/smb.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RuntimeDirectory=nocs-share nocs-share/lock nocs-share/state nocs-share/cache nocs-share/ncalrpc
RuntimeDirectoryPreserve=yes
LimitNOFILE=16384
# A copy to a desktop yields to frames being saved (ADR 0037).
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryMax=512M
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
