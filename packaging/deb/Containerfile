# Builds the nocs .deb (ADR 0025) on the release it targets. Run natively on each
# architecture: the Python environment is created where it is installed, /opt/nocs.
FROM ubuntu:26.04

ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.12.7 /uv /usr/local/bin/uv
