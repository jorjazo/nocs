# nocsd, with indiserver and PHD2 as services of their own: restarting nocsd
# leaves the drivers and guiding running (ADR 0011, ADR 0022, ADR 0025).
# Settings in /etc/nocs/nocsd.env override the paths below.
[Unit]
Description=NOCS server
Documentation=https://github.com/jorjazo/nocs
Wants=nocs-indiserver.service nocs-phd2.service nocs-system.service
# Not network-online.target: in the field there may be no network at all.
After=network.target nocs-indiserver.service nocs-phd2.service nocs-system.service

[Service]
User=nocs
Group=nocs
Environment=NOCS_HOST=0.0.0.0
Environment=NOCS_PORT=8000
Environment=NOCS_CONFIG_DIR=/var/lib/nocs/config
Environment=NOCS_DATA_DIR=/var/lib/nocs
Environment=NOCS_WEB_DIR=/opt/nocs/web
Environment=NOCS_INDI_FIFO=/run/indi/fifo
Environment=NOCS_INDI_UPLOAD_DIR=/var/lib/nocs/indi-uploads
Environment=NOCS_PHD2_SETTINGS=/var/lib/nocs/phd2.phd
Environment=NOCS_SYSTEM_SOCKET=/run/nocs-system/socket
EnvironmentFile=/etc/nocs/nocsd.env
# nocsd feeds the watchdog from its event loop: stuck for 30 s, it is restarted.
Type=notify
NotifyAccess=main
WatchdogSec=30
ExecStart=/opt/nocs/venv/bin/nocsd
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
