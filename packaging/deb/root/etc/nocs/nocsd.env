# nocsd's settings: NOCS_* variables, listed in server/src/nocs/config.py. They
# override the ones set in nocsd.service. After changing them:
#   sudo systemctl restart nocsd
# Where clients reach it (nocsd.service: every interface, port 8000; the appliance
# uses port 80):
#NOCS_HOST=0.0.0.0
#NOCS_PORT=8000
NOCS_LOG_LEVEL=info
# Host names clients may use besides IP addresses, localhost and *.local (ADR 0014):
#NOCS_HOSTNAMES=nocs.lan
