#!/bin/sh
# As dh_installsystemd generates it. /var/lib/nocs is kept even on purge: it holds
# the owner's frames and catalog.
set -e

if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi
if [ -x /usr/bin/deb-systemd-helper ]; then
    if [ "$1" = "remove" ]; then
        deb-systemd-helper mask nocsd.service >/dev/null || true
    fi
    if [ "$1" = "purge" ]; then
        deb-systemd-helper purge nocsd.service >/dev/null || true
        deb-systemd-helper unmask nocsd.service >/dev/null || true
    fi
fi
